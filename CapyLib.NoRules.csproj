<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>CapyLib.NoRules</AssemblyName>
        <RootNamespace>Capy.NoRules</RootNamespace>
        <Authors>CapybaraPR</Authors>
        <Company>CapybaraPR</Company>
        <Product>CapyLib.NoRules</Product>
        <Version>1.3.4</Version>
        <Description>Capybara NoRules Server Gameplay Plugin for SCP:SL EXILED</Description>
        <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
        <NoWarn>$(NoWarn);MSB3270;MSB3277;CS0618;CS0012;CS1705</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- CapyLib Core Framework -->
        <Reference Include="CapyLib">
            <HintPath>..\CapyLib\bin\Release\net48\CapyLib.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- EXILED Dependencies -->
        <Reference Include="Exiled.API">
            <HintPath>..\CapyLib\_deps\Exiled.API.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Exiled.Events">
            <HintPath>..\CapyLib\_deps\Exiled.Events.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Exiled.Loader">
            <HintPath>..\CapyLib\_deps\Exiled.Loader.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Exiled.CustomItems">
            <HintPath>..\CapyLib\_deps\Exiled.CustomItems.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Exiled.CustomRoles">
            <HintPath>..\CapyLib\_deps\Exiled.CustomRoles.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Exiled.Permissions">
            <HintPath>..\CapyLib\_deps\Exiled.Permissions.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- LabApi -->
        <Reference Include="LabApi">
            <HintPath>..\CapyLib\_deps\LabApi.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- Unity & Game Assemblies -->
        <Reference Include="CommandSystem.Core">
            <HintPath>..\CapyLib\_deps\CommandSystem.Core.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>..\CapyLib\_deps\Assembly-CSharp-firstpass.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp_publicized">
            <HintPath>..\CapyLib\_deps\Assembly-CSharp_publicized.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>..\CapyLib\_deps\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>..\CapyLib\_deps\UnityEngine.PhysicsModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Mirror">
            <HintPath>..\CapyLib\_deps\Mirror.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="YamlDotNet">
            <HintPath>..\CapyLib\_deps\YamlDotNet.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="AudioPlayerApi">
            <HintPath>..\CapyLib\_deps\AudioPlayerApi.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
